# SQLite by default (zero-config). Swap to a Postgres URL for production
# (see README "Moving to Postgres") — Prisma schema uses `String` fields
# instead of native enums specifically so this swap doesn't require a
# schema rewrite.
DATABASE_URL="file:./dev.db"

# Symmetric secret used to sign session cookies (jose/HS256).
# Generate your own with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"
