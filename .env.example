# A real Postgres connection string — required, including for local dev.
# Get one free from Vercel (Storage tab), Neon, or Supabase, or run Postgres
# locally (e.g. `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres`).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Symmetric secret used to sign session cookies (jose/HS256).
# Generate your own with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"
