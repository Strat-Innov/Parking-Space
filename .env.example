# A real Postgres connection string — required, including for local dev.
# Get one free from Vercel (Storage tab), Neon, or Supabase, or run Postgres
# locally (e.g. `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres`).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Symmetric secret used to sign session cookies (jose/HS256).
# Generate your own with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"

# Comma-separated list of email domains allowed to self-service signup at
# /signup (public, no login required). Domain match is case-insensitive and
# checked against the part after "@". Self-service accounts are always
# created as Prepared By — higher roles are only granted via the staff-only
# Add Account flow at /accounts.
ALLOWED_SIGNUP_EMAIL_DOMAINS="filinvestcity.com,parkingproinc.com"

# Resend (resend.com) API key — used to send account-confirmation email from
# /signup. Create a free account, verify a sending domain, and generate a
# key from the dashboard.
RESEND_API_KEY=""

# Verified sender address in Resend, e.g. "Parking Pro Inc. <noreply@parkingproinc.com>".
# Defaults to Resend's shared onboarding@resend.dev address, which only
# delivers to the account owner's own inbox — fine for testing, not for
# real signups.
EMAIL_FROM="Parking Pro Inc. <onboarding@resend.dev>"

# Absolute base URL of the deployed app, used to build the confirmation link
# in emails (e.g. "https://parking-space-ten.vercel.app"). Falls back to
# Vercel's auto-injected VERCEL_URL, then localhost, if unset.
APP_URL=""
