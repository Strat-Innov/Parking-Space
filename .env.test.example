# Connection string for a THROWAWAY Postgres database used by `npm test`.
#
# The suite truncates every table before each test. Point this at a database
# you are happy to lose — never at a development or production database. The
# harness additionally refuses to run unless the database name contains "test"
# (see tests/helpers/db.ts).
#
# Create one locally with:
#   createdb parkspace_test
# then apply the schema with:
#   npm run test:db:push
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/parkspace_test"
