// Parking Space Request Automation — data model
//
// Fields intentionally use String instead of Prisma `enum` — this schema
// started on SQLite (no native enum support) and now targets Postgres for
// real deployments (e.g. Vercel, whose serverless functions have no
// writable persistent filesystem for a file-based SQLite database). Kept
// as String/zod-validated (src/lib/types.ts) rather than switching to
// Prisma enums so the datasource stays swappable without a schema rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String // REQUESTER | PREPARED_BY | VALIDATED_BY | PARKING_MANAGEMENT (CASHIER retired — historical rows may still carry it)
  createdAt    DateTime @default(now())

  // Email confirmation (self-service /signup only — see src/lib/signup.ts).
  // Accounts added by an existing staff member via /accounts are already
  // vouched for and get emailVerifiedAt set immediately, skipping this.
  // Login is refused while emailVerifiedAt is null.
  emailVerifiedAt                 DateTime?
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?

  // false only between a staff-sent invite (POST /api/accounts/invite,
  // passwordHash is an unusable placeholder) and the invitee accepting it
  // (POST /api/auth/accept-invite, which flips this true). Distinguishes an
  // invited-but-not-accepted row from a self-signup-unconfirmed row — both
  // have emailVerifiedAt null, but need different "resend" emails (see
  // /api/auth/resend-confirmation): an invite link (sets a real password)
  // vs a confirm link (assumes a real password already exists).
  hasPassword Boolean @default(true)

  requestsSubmitted ParkingRequest[] @relation("Requester")
  requestsPrepared  ParkingRequest[] @relation("PreparedBy")
  requestsValidated ParkingRequest[] @relation("ValidatedBy")
  requestsRejected  ParkingRequest[] @relation("RejectedBy")
  requestsCashiered ParkingRequest[] @relation("Cashier")
  requestsAssigned  ParkingRequest[] @relation("AssignedBy")
  rateTableEntries  RateTableEntry[] @relation("RateCreatedBy")
  parkingSpaces     ParkingSpace[]   @relation("ParkingSpaceCreatedBy")
  events            RequestEvent[]   @relation("EventActor")

  accessRequestsSubmitted  AccessRequest[]      @relation("AccessRequester")
  accessRequestsProcessed  AccessRequest[]      @relation("AccessProcessedBy")
  accessRequestsCompleted  AccessRequest[]      @relation("AccessCompletedBy")
  accessRequestsCancelled  AccessRequest[]      @relation("AccessCancelledBy")
  accessEvents             AccessRequestEvent[] @relation("AccessEventActor")
}

model ParkingRequest {
  id String @id @default(cuid())

  // --- Section 5: intake fields ---
  // fullName is a build-time addition beyond the original Section 5 field
  // list — needed once submission went public (see /requests/new): a
  // company name alone doesn't say who to actually contact.
  fullName                 String
  companyName              String
  emailAddress              String
  serviceType                String // Hourly | Daily | Monthly
  preferredParkingLocation   String
  // Requestor's optional hint at a specific slot — NOT the real assignment.
  // Parking Management still does the actual, authoritative assignment via
  // WF05 (see assignedSlot below); this is just a preference to consider.
  requestedSlot                String?
  dateOfRequest                 DateTime @default(now()) // system-set (BR-001/002/003)
  requiredStartDate            DateTime
  endDate                        DateTime
  purpose                          String

  // --- Section 2: primary lifecycle (BR-008: never encodes ownership) ---
  status String @default("Submitted")
  // Submitted | In Preparation | Pending Approval | Approved | Completed | Cancelled

  // --- Section 4: single-owner progression up to Approved, then Post-Approval ---
  approvalStage String @default("Prepared By")
  // Prepared By | Validated By | Post-Approval | Completed

  // --- independent parallel tracks (BR-006) ---
  paymentStatus String @default("Not Started") // Not Started | Pending | Confirmed
  slotStatus    String @default("Unassigned") // Unassigned | Assigned

  // WF02
  preparedById String?
  preparedBy   User?   @relation("PreparedBy", fields: [preparedById], references: [id])

  // WF03
  validatedById    String?
  validatedBy      User?     @relation("ValidatedBy", fields: [validatedById], references: [id])
  approvalDecision String? // Approved | Rejected (most recent decision)
  validatedDate    DateTime?

  // WF03 reject branch — audit (Section 8, BR-004)
  rejectionCount  Int       @default(0)
  rejectionReason String?
  rejectedById    String?
  rejectedBy      User?     @relation("RejectedBy", fields: [rejectedById], references: [id])
  rejectedDate    DateTime?

  // WF04
  cashierId                String?
  cashier                  User?     @relation("Cashier", fields: [cashierId], references: [id])
  payDate                  DateTime?
  officialReceiptReference String?

  // WF05 — assignedSlot is a human-readable snapshot ("<location> — <slot>")
  // kept for display/audit even if the ParkingSpace row is later removed;
  // parkingSpaceId is the real FK used for date-range availability checks.
  assignedSlot       String?
  parkingSpaceId     String?
  parkingSpace       ParkingSpace? @relation(fields: [parkingSpaceId], references: [id])
  slotAssignmentDate DateTime?
  assignedById       String?
  assignedBy         User?     @relation("AssignedBy", fields: [assignedById], references: [id])

  // computed at submission, from requiredStartDate/endDate + serviceType
  totalHours  Float?
  totalDays   Float?
  totalMonths Float?

  // Section 7: rate integrity — snapshot at WF03 approval, never re-derived later
  rateVersionId      String?
  rateVersion        RateTableEntry? @relation(fields: [rateVersionId], references: [id])
  rateAmountSnapshot Float?
  rateSnapshotDate   DateTime?
  totalPaymentDue    Float?

  // WF06 — sole writer of Status = Completed
  completedDate DateTime?

  requesterId String
  requester   User   @relation("Requester", fields: [requesterId], references: [id])

  events RequestEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Section 7 — append-only. Rows are never edited after creation; a rate
// change is a new row with a new effectiveStartDate. "Current rate" is
// resolved by querying the latest row with effectiveStartDate <= now,
// never by mutating an older row's effectiveEndDate.
model RateTableEntry {
  id                 String    @id @default(cuid())
  serviceType        String
  chargingModel       String
  rateAmount           Float
  effectiveStartDate    DateTime
  effectiveEndDate      DateTime? // reserved for display use only; see resolution note above
  createdById            String
  createdBy              User      @relation("RateCreatedBy", fields: [createdById], references: [id])
  createdAt               DateTime  @default(now())

  requests ParkingRequest[]
}

// Parking Location inventory — unlike the append-only Rate Table, this list
// is mutable: a physical space can be added or removed outright. Removal is
// soft (isActive = false, never hard-deleted) so past assignments keep a
// valid parkingSpaceId to point at. "Assigned or not" is deliberately NOT a
// static column here — a space is only unavailable for the specific date
// range it's actually booked, derived by checking ParkingRequest rows with
// a matching parkingSpaceId and an overlapping [requiredStartDate, endDate]
// (see isSpaceAvailable in workflows.ts), not a permanent flag on the space.
model ParkingSpace {
  id          String   @id @default(cuid())
  location    String
  slotNumber  String
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("ParkingSpaceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  requests ParkingRequest[]
}

// Section 8 note: Microsoft Lists gives native per-item version history for
// free; outside SharePoint that isn't automatic, so this table is the
// explicit substitute — one append-only row per workflow transition.
model RequestEvent {
  id         String   @id @default(cuid())
  requestId  String
  request    ParkingRequest @relation(fields: [requestId], references: [id])
  workflow   String // WF01..WF06
  fromStatus String?
  toStatus   String?
  actorId    String?
  actor      User?    @relation("EventActor", fields: [actorId], references: [id])
  note       String?
  createdAt  DateTime @default(now())
}

// --- Parking Access (RFID/Card/Metal Tag enrollment) --------------------
//
// A second, parallel request type — same login-capable roles as Parking
// Space (Prepared By, Validated By, Parking Management; the system
// selector at login just picks which dashboard you land on, not a
// separate permission set), but a distinct data model and a deliberately
// simpler, single-track lifecycle, since the paper process it replicates
// ("Enrollment for Parking ACCESS", PPI Form2_Rev4_7) has no fork-join
// structure like Parking Space's BR-006 payment/slot tracks: Submitted ->
// Processed (Parking Management validates/endorses and logs the actual
// access series + charge in one step, mirroring the form's single
// combined "Validation of Document & Access Endorsement" box) ->
// Completed (Parking Management confirms the client received it) or
// Cancelled from either non-terminal state.
model AccessRequest {
  id String @id @default(cuid())

  // --- intake ---
  enrollmentType String // Individual | Corporate
  requestType    String // New Enrollment | Replacement | Deactivation/Cancellation | Renewal | Reactivation | Transfer
  transferTo     String? // only meaningful when requestType = Transfer
  transferFrom   String?

  fullName           String
  companyName        String
  emailAddress       String
  vehiclePlateNumber String
  propertyLocation   String
  contactNumber      String
  dateOfRequest      DateTime @default(now()) // system-set, same BR-003 spirit as Parking Space
  requestedQuantity  Int
  accessType         String // RFID Sticker/Card/Metal Tag | Manual Pass
  remarks            String?
  // The form's "APPROVED BY: Requestor's Authorized Approver Only" line —
  // someone at the CLIENT company, not our staff. Captured as plain text
  // only (no login exists for external companies), not a workflow gate.
  approverName       String?

  status String @default("Submitted") // Submitted | Processed | Completed | Cancelled

  // Combined validation/endorsement + access issuance, one staff action
  // (Parking Management) matching the form's single combined box.
  processedById      String?
  processedBy        User?     @relation("AccessProcessedBy", fields: [processedById], references: [id])
  processedDate      DateTime?
  confirmedQuantity  Int?
  accessSeriesRef    String?
  purchasedCharge    Float?
  officialReceiptRef String?
  staffRemarks       String?

  // "The client hereby received the number of requested parking access in
  // good order" — recorded by staff, since the client has no login to
  // confirm this themselves.
  receivedByName String?
  completedById  String?
  completedBy    User?     @relation("AccessCompletedBy", fields: [completedById], references: [id])
  completedDate  DateTime?

  cancelledById String?
  cancelledBy   User?     @relation("AccessCancelledBy", fields: [cancelledById], references: [id])
  cancelledDate DateTime?

  requesterId String
  requester   User   @relation("AccessRequester", fields: [requesterId], references: [id])

  events AccessRequestEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccessRequestEvent {
  id         String        @id @default(cuid())
  requestId  String
  request    AccessRequest @relation(fields: [requestId], references: [id])
  workflow   String // AWF01 Submit | AWF02 Process | AWF03 Complete | Cancel
  fromStatus String?
  toStatus   String?
  actorId    String?
  actor      User?    @relation("AccessEventActor", fields: [actorId], references: [id])
  note       String?
  createdAt  DateTime @default(now())
}
